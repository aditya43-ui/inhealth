ult0 \fs18\cf0\par\pard\li5373\ri0\sl-440\slmult0 \fs24\cf0\f1\charscalex100 {5 }\par\pard\sect\sectd\sbkpage\pgwsxn11893\pghsxn16826\marglsxn666\margrsxn133\margtsxn666\margbsxn173\pard\li5106\ri0\sl-213\slmult0 \fs18\cf0\par\pard\li5106\ri0\sl-213\slmult0 \fs18\cf0\par\pard\li5106\ri0\sl-213\slmult0 \fs18\cf0\par\pard\li5106\ri0\sl-213\slmult0 \fs18\cf0\par\pard\li5106\ri0\sl-493\slmult0 \fs30\cf0\f1\charscalex100\b {BAB  II }\b0 \par\pard\li3973\ri0\sl-493\slmult0 \fs30\cf0\f1\charscalex100\b {PENGISIAN FORMULIR }\b0 \par\pard\li1600\ri0\sl-213\slmult0 \fs18\cf0\par\pard\li1600\ri0\sl-213\slmult0 \fs18\cf0\par\pard\li1600\ri0\sl-426\slmult0 \*\tx2173\fs24\cf0\f1\charscalex100\b {A.}\b0 \tab \fs24\cf0\f1\charscalex100\b {PENDAHULUAN }\b0 \par\pard\li2733\ri0\sl-400\slmult0 \fs24\cf0\f1\charscalex100 {Sifat pelaporan SIRS sebagaimana dimaksud pada  PERMENKES RI }\par\pard\li2173\ri0\sl-426\slmult0 \fs22\cf0\f1\charscalex100 {NOMOR 1171/MENKES/PER/VI/2011  ditetapkan oleh Direktur  Jenderal }\par\pard\li2173\ri0\sl-413\slmult0 \fs22\cf0\f1\charscalex100 {Bina Upaya  Kesehatan.  Formulir pelaporan  SIRS  terdiri dari 5 (lima) }\par\pard\li2173\ri0\sl-413\slmult0 \fs24\cf0\f1\charscalex100 {Rekapitulasi Laporan (RL), diantaranya : }\par\pard\li2173\ri0\sl-413\slmult0 \fs24\cf0\f1\charscalex100 {1.}{ }\fs24\cf0\f1\charscalex100 {RL  1 berisikan Data Dasar Rumah Sakit  yang dilaporkan setiap waktu }\par\pard\li2453\ri0\sl-413\slmult0 \fs22\cf0\f1\charscalex100 {apabila terdapat perubahan data dasar dari rumah sakit sehingga data ini }\par\pard\li2453\ri0\sl-413\slmult0 \fs24\cf0\f1\charscalex100 {dapat dikatakan data yang yang bersifat terbarukan setiap saat (}\fs24\cf0\f1\charscalex100\i {updated}\i0 \fs24\cf0\f1\charscalex100 {) }\par\pard\li2173\ri0\sl-413\slmult0 \fs24\cf0\f1\charscalex100 {2.}{ }\fs24\cf0\f1\charscalex100 {RL 2 berisikan Data Ketenagaan yang dilaporkan periodik setiap tahun }\par\pard\li2173\ri0\sl-413\slmult0 \fs24\cf0\f1\charscalex100 {3.}{ }\fs24\cf0\f1\charscalex100 {RL  3 berisikan Data  Kegiatan Pelayanan Rumah  Sakit  yang  dilaporkan}\par\pard\li2453\ri0\sl-413\slmult0 \fs24\cf0\f1\charscalex100 {periodik setiap tahun }\par\pard\li2173\ri0\sl-413\slmult0 \fs24\cf0\f1\charscalex100 {4.}{ }\fs24\cf0\f1\charscalex100 {RL  4 berisikan Data Morbiditas/Mortalitas Pasien yang  dilaporkan}\par\pard\li2453\ri0\sl-413\slmult0 \fs24\cf0\f1\charscalex100 {periodik setiap tahun }\par\pard\li2173\ri0\sl-413\slmult0 \fs24\cf0\f1\charscalex100 {5.}{ }\fs24\cf0\f1\charscalex100 {RL  5  yang merupakan Data Bulanan yang  dilaporkan secara  periodik}\par\pard\li2453\ri0\sl-413\slmult0 \fs22\cf0\f1\charscalex100 {setiap bulan, berisikan data kunjungan dan data 10 (sepuluh) besar }\par\pard\li2453\ri0\sl-413\slmult0 \fs24\cf0\f1\charscalex100 {penyakit. }\par\pard\li2733\ri0\sl-413\slmult0 \fs24\cf0\f1\charscalex100 {Cara pengisian formulir pelaporan yang terdapat dalam buku petunjuk}\par\pard\li2173\ri0\sl-413\slmult0 \fs24\cf0\f1\charscalex100 {teknis SIRS  ini  hanya  menguraikan hal-hal yang  masih kurang  jelas atau}\par\pard\li2173\ri0\sl-413\slmult0 \fs24\cf0\f1\charscalex100 {belum  dimengerti oleh tenaga    Rumah Sakit  dikarenakan  adanya  format}\par\pard\li2173\ri0\sl-413\slmult0 \fs24\cf0\f1\charscalex100 {formulir  yang  baru  sesuai dengan PERMENKES RI  NOMOR}\par\pard\li2173\ri0\sl-413\slmult0 \fs24\cf0\f1\charscalex100 {1171/MENKES/PER/VI/2011 tanggal 15 Juni 2011. }\par\pard\li1600\ri0\sl-213\slmult0 \fs18\cf0\par\pard\li1600\ri0\sl-213\slmult0 \fs18\cf0\par\pard\li1600\ri0\sl-213\slmult0 \fs18\cf0\par\pard\li1600\ri0\sl-213\slmult0 \fs18\cf0\par\pard\li1600\ri0\sl-400\slmult0 \*\tx2173\fs24\cf0\f1\charscalex100\b {B.}\b0 \tab \fs24\cf0\f1\charscalex100\b {PENJELASAN CARA PENGISIAN  }\b0 \par\pard\li2173\ri0\sl-413\slmult0 \fs24\cf0\f1\charscalex100\b {1. Formulir RL 1 }\b0 \par\pard\li2173\ri0\sl-413\slmult0 \fs24\cf0\f1\charscalex100\b {a. Formulir Data Dasar Rumah Sakit (Formulir RL 1.1)}\b0 \par\pard\li2453\ri0\sl-413\slmult0 \fs22\cf0\f1\charscalex100 {Formulir RL1.1  adalah  formulir untuk data  dasar rumah sakit  yang }\par\pard\li2453\ri0\sl-413\slmult0 \fs22\cf0\f1\charscalex100 {dilaporkan setiap waktu apabila  ada  perubahan  data rumah sakit. }\par\pard\li2453\ri0\sl-413\slmult0 \fs22\cf0\f1\charscalex100 {Pengisian dapat dilakukan di aplikasi RS Online. Untuk data yang tidak }\par\pard\li5506\ri0\sl-213\slmult0 \fs18\cf0\par\pard\li5506\ri0\sl-213\slmult0 \fs18\cf0\par\pard\li5506\ri0\sl-466\slmult0 \fs24\cf0\f1\charscalex100 {6 }\par\pard\sect\sectd\sbkpage
