\pard\sect\sectd\sbkpage\pgwsxn11906\pghsxn16826\marglsxn666\margrsxn133\margtsxn666\margbsxn240\pard\li4773\ri0\sl-213\slmult0 \fs18\cf0\par\pard\li4773\ri0\sl-213\slmult0 \fs18\cf0\par\pard\li4773\ri0\sl-213\slmult0 \fs18\cf0\par\pard\li4773\ri0\sl-213\slmult0 \fs18\cf0\par\pard\li4773\ri0\sl-493\slmult0 \fs30\cf0\f1\charscalex100\b {SAMBUTAN }\b0 \par\pard\li1600\ri0\sl-213\slmult0 \fs18\cf0\par\pard\li1600\ri0\sl-213\slmult0 \fs18\cf0\par\pard\li1600\ri0\sl-426\slmult0 \fs24\cf0\f1\charscalex100 {Puji  dan syukur kita  sampaikan ke  dadirat Allah SWT yang  telah melimpahkan}\par\pard\li1600\ri0\sl-413\slmult0 \fs22\cf0\f1\charscalex100 {rahmat dan hidayah-Nya, sehingga dapat tersusun Buku Petunjuk Pengisian,}\par\pard\li1600\ri0\sl-413\slmult0 \fs22\cf0\f1\charscalex100 {Pengolahan Data Rumah Sakit.  Buku ini  berisikan petunjuk teknis mengenai}\par\pard\li1600\ri0\sl-413\slmult0 \fs22\cf0\f1\charscalex100 {Sistem Informasi pelaporan rumah sakit  yang  merupakan Lampiran Peraturan}\par\pard\li1600\ri0\sl-413\slmult0 \fs22\cf0\f1\charscalex100 {Menteri Kesehatan  Republik Indonesia NOMOR  1171/MENKES/PER/VI/2011}\par\pard\li1600\ri0\sl-426\slmult0 \fs24\cf0\f1\charscalex100 {Tentang  Sistem Informasi Rumah Sakit  tertanggal 1}\fs24\cf0\f1\charscalex100 {5 }\fs24\cf0\f1\charscalex100 {Juni 2011 dan telah di }\par\pard\li1600\ri0\sl-400\slmult0 \fs24\cf0\f1\charscalex100 {undangkan tertanggal 1 juli 2011 di Jakarta. }\par\pard\li1600\ri0\sl-426\slmult0 \fs24\cf0\f1\charscalex100 {Di dalam Buku Petujuk ini diuraikan bagaimana cara mengisi dan mengolah  data}\par\pard\li1600\ri0\sl-413\slmult0 \fs22\cf0\f1\charscalex100 {Rumah Sakit, dengan harapan  dapat membantu  Rumah Sakit  dalam mengisi }\par\pard\li1600\ri0\sl-413\slmult0 \fs22\cf0\f1\charscalex100 {laporan yang telah ditentukan, yang terdiri dari laporan Data Dasar Rumah Sakit }\par\pard\li1600\ri0\sl-413\slmult0 \fs24\cf0\f1\charscalex100 {(RL 1) sampai dengan Data Bulanan (RL 5) dengan baik dan benar, sehingga data}\par\pard\li1600\ri0\sl-413\slmult0 \fs22\cf0\f1\charscalex100 {tersebut diharapkan dapat dipakai untuk menentukan kebijakan di Bidang Upaya }\par\pard\li1600\ri0\sl-413\slmult0 \fs24\cf0\f1\charscalex100 {Kesehatan. }\par\pard\li1600\ri0\sl-413\slmult0 \fs22\cf0\f1\charscalex100 {Kami harapkan Buku Petunjuk Pengisian ini dapat dijadikan pegangan bagi setiap }\par\pard\li1600\ri0\sl-413\slmult0 \fs22\cf0\f1\charscalex100 {Rumah Sakit  dalam membuat laporan  yang telah ditentukan dan mengirimkan }\par\pard\li1600\ri0\sl-413\slmult0 \fs24\cf0\f1\charscalex100 {data/laporan ke Instansi terkait.  }\par\pard\li1600\ri0\sl-413\slmult0 \fs24\cf0\f1\charscalex100 {Kepada  semua  pihak yang  telah membantu sampai dengan tersusunnya  Buku}\par\pard\li1600\ri0\sl-413\slmult0 \fs22\cf0\f1\charscalex100 {Petunjuk Pengisian ini kami sampaikan penghargaan dan terima kasih. Kritik dan }\par\pard\li1600\ri0\sl-413\slmult0 \fs24\cf0\f1\charscalex100 {Saran membangun yang disampaikan kepada kami akan sangat bermanfaat untuk}\par\pard\li1600\ri0\sl-413\slmult0 \fs24\cf0\f1\charscalex100 {perbaikan dimasa mendatang. }\par\pard\li5426\ri0\sl-213\slmult0 \fs18\cf0\par\pard\li5426\ri0\sl-213\slmult0 \fs18\cf0\par\pard\li5426\ri0\sl-213\slmult0 \fs18\cf0\par\pard\li5426\ri0\sl-213\slmult0 \fs18\cf0\par\pard\li5426\ri0\sl-386\slmult0 \fs24\cf0\f1\charscalex100 {Jakarta,    Agustus 2011 }\par\pard\li5426\ri0\sl-413\slmult0 \fs24\cf0\f1\charscalex100 {Direktur Jenderal Bina Upaya Kesehatan }\par\pard\li5426\ri0\sl-213\slmult0 \fs18\cf0\par\pard\li5426\ri0\sl-213\slmult0 \fs18\cf0\par\pard\li5426\ri0\sl-213\slmult0 \fs18\cf0\par\pard\li5426\ri0\sl-213\slmult0 \fs18\cf0\par\pard\li5426\ri0\sl-400\slmult0 \fs24\cf0\f1\charscalex100\b {Dr.Supriyantoro , Sp.P, MARS }\b0 \par\pard\li5426\ri0\sl-413\slmult0 \fs24\cf0\f1\charscalex100 {NIP. 195408112010061001    }\par\pard\sect\sectd\sbkpage\pgwsxn11906\pghsxn16826\marglsxn666\margrsxn133\margtsxn666\margbsxn240\pard\li4400\ri0\sl-213\slmult0 \fs18\cf0\par\pard\li4400\ri0\sl-213\slmult0 \fs18\cf0\par\pard\li4400\ri0\sl-213\slmult0 \fs18\cf0\par\pard\li4400\ri0\sl-213\slmult0 \fs18\cf0\par\pard\li4400\ri0\sl-453\slmult0 \fs24\cf0\f1\charscalex100\b {KATA  PENGANTAR }\b0 \par\pard\li1600\ri0\sl-213\slmult0 \fs18\cf0\par\pard\li1600\ri0\sl-213\slmult0 \fs18\cf0\par\pard\li1600\ri0\sl-400\slmult0 \fs24\cf0\f1\charscalex100 {Kebutuhan akan data dan informasi saat ini berkembang sangat pesat, dilihat dari}\par\pard\li1600\ri0\sl-413\slmult0 \fs24\cf0\f1\charscalex100 {segi kuantitas maupun kualitasnya. Dengan telah berlakunya  Undang-Undang }\par\pard\li1600\ri0\sl-413\slmult0 \fs22\cf0\f1\charscalex100 {Nomor  14 Tahun 2008 tentang  Keterbukaan  Informasi  Publik (KIP) maka }\par\pard\li1600\ri0\sl-413\slmult0 \fs22\cf0\f1\charscalex100 {tersedianya  data dan informasi mutlak dibutuhkan terutama  oleh badan layanan }\par\pard\li1600\ri0\sl-413\slmult0 \fs24\cf0\f1\charscalex100 {umum seperti rumah sakit.  }\par\pard\li1600\ri0\sl-213\slmult0 \fs18\cf0\par\pard\li1600\ri0\sl-213\slmult0 \fs18\cf0\par\pard\li1600\ri0\sl-400\slmult0 \fs24\cf0\f1\charscalex100 {Data dan Informasi tersebut setiap tahunnya mengalami perubahan seiring dengan}\par\pard\li1600\ri0\sl-413\slmult0 \fs22\cf0\f1\charscalex100 {perkembangan jaman, sehingga revisi dalam Sistem Informasi Rumah Sakit yang }\par\pard\li1600\ri0\sl-426\slmult0 \fs24\cf0\f1\charscalex100 {sudah ada saat ini mutlak dibutuhkan. }\par\pard\li1600\ri0\sl-213\slmult0 \fs18\cf0\par\pard\li1600\ri0\sl-213\slmult0 \fs18\cf0\par\pard\li1600\ri0\sl-400\slmult0 \fs22\cf0\f1\charscalex100 {Sistem Informasi Rumah Sakit  (SIRS)  adalah suatu proses pengumpulan, }\par\pard\li1600\ri0\sl-413\slmult0 \fs22\cf0\f1\charscalex100 {pengolahan dan penyajian data rumah sakit  se-Indonesia. Sistem Informasi ini }\par\pard\li1600\ri0\sl-413\slmult0 \fs22\cf0\f1\charscalex100 {mencakup semua Rumah Sakit umum maupun khusus, baik yang dikelola secara }\par\pard\li1600\ri0\sl-413\slmult0 \fs22\cf0\f1\charscalex100 {publik maupun privat sebagaimana  diatur  dalam Undang-Undang  Republik }\par\pard\li1600\ri0\sl-413\slmult0 \fs22\cf0\f1\charscalex100 {Indonesia Nomor  44 Tahun 2009 tentang  Rumah Sakit.  SIRS  ini  merupakan }\par\pard\li1600\ri0\sl-413\slmult0 \fs24\cf0\f1\charscalex100 {penyempurnaan dari SIRS Revisi V yang disusun  berdasarkan masukan dari tiap}\par\pard\li1600\ri0\sl-413\slmult0 \fs22\cf0\f1\charscalex100 {Direktorat dan Sekretariat dilingkungan Direktorat Jenderal Bina  Upaya }\par\pard\li1600\ri0\sl-413\slmult0 \fs24\cf0\f1\charscalex100 {Kesehatan. Hal ini  diperlukan agar dapat menunjang  pemanfaatan data  yan}\fs24\cf0\f1\charscalex100 {g}\par\pard\li1600\ri0\sl-413\slmult0 \fs22\cf0\f1\charscalex100 {optimal serta  semakin meningkatnya  kebutuhan data saat ini  dan yang  akan }\par\pard\li1600\ri0\sl-413\slmult0 \fs24\cf0\f1\charscalex100 {datang. }\par\pard\li1600\ri0\sl-213\slmult0 \fs18\cf0\par\pard\li1600\ri0\sl-213\slmult0 \fs18\cf0\par\pard\li1600\ri0\sl-400\slmult0 \fs22\cf0\f1\charscalex100 {Berdasarkan pengalaman pelaksanaan di Rumah Sakit, pedoman sistem informasi }\par\pard\li1600\ri0\sl-413\slmult0 \fs22\cf0\f1\charscalex100 {rumah sakit  tersebut belum  dapat memberikan gambaran pencatatan  secara }\par\pard\li1600\ri0\sl-413\slmult0 \fs24\cf0\f1\charscalex100 {lengkap terhadap semua kegiatan di Rumah Sakit, sehingga dirasakan sangat perlu}\par\pard\li1600\ri0\sl-413\slmult0 \fs24\cf0\f1\charscalex100 {untuk menyusun Buku  Petunjuk Pengisian, Pengolahan dan Penyajian Data}\par\pard\li1600\ri0\sl-413\slmult0 \fs24\cf0\f1\charscalex100 {Rumah Sakit. }\par\pard\li1600\ri0\sl-213\slmult0 \fs18\cf0\par\pard\li1600\ri0\sl-213\slmult0 \fs18\cf0\par\pard\li1600\ri0\sl-400\slmult0 \fs24\cf0\f1\charscalex100 {Diharapkan  Buku Petunjuk teknis ini  dapat menjadi suatu pedoman didalam}\par\pard\li1600\ri0\sl-413\slmult0 \fs24\cf0\f1\charscalex100 {pengisian, pengolahan dan penyajian data rumah sakit  yang tercantum  didalam}\par\pard\li1600\ri0\sl-426\slmult0 \*\tx2800\*\tx3986\*\tx5026\*\tx6293\*\tx7440\*\tx8640\fs24\cf0\f1\charscalex100 {Lampiran}\tab \fs24\cf0\f1\charscalex100 {Peraturan}\tab \fs24\cf0\f1\charscalex100 {Menteri}\tab \fs24\cf0\f1\charscalex100 {Kesehatan}\tab \fs24\cf0\f1\charscalex100 {Republik}\tab \fs24\cf0\f1\charscalex100 {Indonesia}\tab \fs24\cf0\f1\charscalex100 {NOMOR}\par\pard\sect\sectd\sbkpage\pgwsxn11906\pghsxn16826\marglsxn666\margrsxn133\margtsxn666\margbsxn240\pard\li1600\ri0\sl-213\slmult0 \fs18\cf0\par\pard\li1600\ri0\sl-213\slmult0 \fs18\cf0\par\pard\li1600\ri0\sl-213\slmult0 \fs18\cf0\par\pard\li1600\ri0\sl-213\slmult0 \fs18\cf0\par\pard\li1600\ri0\sl-453\slmult0 \fs24\cf0\f1\charscalex100 {1171/MENKES/PER/VI/2011 Tentang Sistem Informasi Rumah Sakit mulai dari}\par\pard\li1600\ri0\sl-413\slmult0 \fs24\cf0\f1\charscalex100 {Laporan Data Kegiatan Rumah Sakit (RL 1) sampai dengan Laporan Data  (RL 5}\fs24\cf0\f1\charscalex100 {)}\par\pard\li1600\ri0\sl-413\slmult0 \fs24\cf0\f1\charscalex100 {yang sudah diberlakukan sejak diundangkan tanggal 1 Juli 2011. }\par\pard\li1600\ri0\sl-213\slmult0 \fs18\cf0\par\pard\li1600\ri0\sl-213\slmult0 \fs18\cf0\par\pard\li1600\ri0\sl-400\slmult0 \fs24\cf0\f1\charscalex100 {Dalam kesempatan ini kami mengucapkan terima kasih kepada semua pihak yang}\par\pard\li1600\ri0\sl-413\slmult0 \fs24\cf0\f1\charscalex100 {telah berperan serta  dalam mewujudkan buku petunjuk teknis  ini}\fs24\cf0\f1\charscalex100 {. }\fs24\cf0\f1\charscalex100 {Akhirnya }\par\pard\li1600\ri0\sl-413\slmult0 \fs24\cf0\f1\charscalex100 {diharapkan agar Rumah Sakit dapat menggunakan Buku Petunjuk Pengisian dan}\par\pard\li1600\ri0\sl-413\slmult0 \fs24\cf0\f1\charscalex100 {Pengolahan Data Rumah Sakit ini dalam melaksanakan Permenkes tersebut. }\par\pard\li5293\ri0\sl-213\slmult0 \fs18\cf0\par\pard\li5293\ri0\sl-213\slmult0 \fs18\cf0\par\pard\li5293\ri0\sl-213\slmult0 \fs18\cf0\par\pard\li5293\ri0\sl-213\slmult0 \fs18\cf0\par\pard\li5293\ri0\sl-213\slmult