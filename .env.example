# ==============================================================================
#  inhealtcare (SIMRS) - Contoh Konfigurasi Environment
# ==============================================================================
#  CARA PAKAI:
#    1. Salin berkas ini menjadi `.env`
#    2. Isi nilainya sesuai lingkungan Anda
#    3. JANGAN pernah commit berkas `.env` (sudah masuk .gitignore)
#
#    cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
#  Mode Aplikasi
# ------------------------------------------------------------------------------
#  production  = YII_DEBUG mati, error disembunyikan, pakai yiilite (lebih cepat)
#  development = YII_DEBUG hidup, stack trace tampil, pakai yii.php
#
#  PENTING: bila variabel ini tidak diset, aplikasi memakai mode `production`.
APP_ENV=development

# ------------------------------------------------------------------------------
#  Database Utama - PostgreSQL
# ------------------------------------------------------------------------------
DB_HOST=10.10.123.206
DB_PORT=5432
DB_NAME=inhealth
DB_USER=postgres
DB_PASS=

# ------------------------------------------------------------------------------
#  Database Radiologi (RIS) - MySQL
# ------------------------------------------------------------------------------
DB_RIS_HOST=10.10.123.38
DB_RIS_PORT=3306
DB_RIS_NAME=fk_radiology
DB_RIS_USER=root
DB_RIS_PASS=

# ------------------------------------------------------------------------------
#  Database Remote Server - PostgreSQL
# ------------------------------------------------------------------------------
DB_REMOTE_HOST=localhost
DB_REMOTE_PORT=5432
DB_REMOTE_NAME=db_server
DB_REMOTE_USER=postgres
DB_REMOTE_PASS=
